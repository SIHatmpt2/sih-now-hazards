# Copy this file to .env and replace every example secret before running.
APP_ENV=development
APP_NAME=SkyIntel
APP_HOST=0.0.0.0
APP_PORT=8001
LOG_LEVEL=INFO
# Database (internal Docker network address)
POSTGRES_DB=skyintel
POSTGRES_USER=skyintel
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+psycopg://skyintel:replace-with-a-long-random-password@postgres:5432/skyintel
# Cache and background jobs
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
# Object storage for satellite imagery and processed artifacts
MINIO_ROOT_USER=skyintel
MINIO_ROOT_PASSWORD=replace-with-another-long-random-password
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY_ID=skyintel
S3_SECRET_ACCESS_KEY=replace-with-another-long-random-password
S3_BUCKET=skyintel-data
S3_REGION=us-east-1
# External weather/satellite providers (fill in when provider is selected)
WEATHER_API_BASE_URL=
WEATHER_API_KEY=
SATELLITE_API_BASE_URL=
SATELLITE_API_KEY=
# Model registry / inference
MODEL_PATH=apps/Models/xgboost_hail_risk.json
MODEL_VERSION=dev
RISK_SCORE_THRESHOLD=0.70
# Security: generate a unique random value for deployments
SECRET_KEY=replace-with-a-unique-random-secret
CORS_ORIGINS=http://localhost:8001,http://127.0.0.1:8001